# OpenCode CLI release pin, managed by Renovate (see renovate.json).
#
# OPENCODE_VERSION and OPENCODE_INTEGRITY must stay on consecutive lines: the
# Renovate regex manager updates both from a single match. The integrity is the
# npm registry's SRI digest for the published tarball. This file is read by
# scripts/install-opencode.sh and .github/actions/setup-opencode/action.yml, so
# it is the only place an OpenCode version may be pinned.
#
# Values are plain data, never sourced: do not add quotes or shell syntax.
OPENCODE_VERSION=2.2.0
OPENCODE_INTEGRITY=sha512-XTGFTiZTgugps6rgTXp4mPjOM8klsa5uHn/Shcms2o3k1bjSA3Sgl6O4yJ48y18WWxn9My5Pxt7JKcLID7LOHg==
OPENCODE_PACKAGE=@opencode/cli-linux-x64

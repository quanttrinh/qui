# Bun release pin, managed by Renovate (see renovate.json).
#
# BUN_TAG and BUN_SHA256 must stay on consecutive lines: the Renovate regex
# manager updates both from a single match. The value is the raw GitHub release
# tag (bun-vX.Y.Z); scripts/install-bun.sh strips the prefix for version checks.
# This file is read by scripts/install-bun.sh and
# .github/actions/setup-bun/action.yml, so it is the only place a Bun version
# may be pinned.
#
# Values are plain data, never sourced: do not add quotes or shell syntax.
BUN_TAG=bun-v1.4.4
BUN_SHA256=bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c
BUN_REPO=oven-sh/bun
BUN_ASSET=bun-linux-x64.zip

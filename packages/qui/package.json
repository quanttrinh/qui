{
  "name": "@quanttrinh/qui",
  "version": "0.7.1",
  "description": "Material Design 3 web components built with Stencil",
  "homepage": "https://quanttrinh.github.io/qui/",
  "bugs": {
    "url": "https://github.com/quanttrinh/qui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanttrinh/qui.git",
    "directory": "packages/qui"
  },
  "files": [
    "dist",
    "styled-system",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/shared/index.js",
  "module": "./dist/shared/index.js",
  "types": "./dist/types/index.d.ts",
  "imports": {
    "#styled-system/css": "./styled-system/css/index.js",
    "#qui-style-url": "./styled-system/style-urls/index.js",
    "#styled-system/tokens": "./styled-system/tokens/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./register": {
      "types": "./dist/utilities/register/index.d.ts",
      "default": "./dist/utilities/register/index.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate/index.d.ts",
      "import": "./dist/hydrate/index.mjs",
      "require": "./dist/hydrate/index.js",
      "default": "./dist/hydrate/index.js"
    },
    "./ssr": {
      "types": "./dist/utilities/ssr/index.d.ts",
      "default": "./dist/utilities/ssr/index.js"
    },
    "./internal": {
      "types": "./dist/utilities/internal/index.d.ts",
      "default": "./dist/utilities/internal/index.js"
    },
    "./runtime": {
      "types": "./dist/utilities/styles/index.d.ts",
      "default": "./dist/utilities/styles/index.js"
    },
    "./theme": {
      "types": "./dist/utilities/theme/index.d.ts",
      "default": "./dist/utilities/theme/index.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "default": "./dist/shared/*.js"
    },
    "./theme.css": "./styled-system/theme.css",
    "./styles.css": "./styled-system/styles.css",
    "./package.json": "./package.json",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    },
    "./types/react": {
      "types": "./dist/types/react.d.ts",
      "default": "./dist/types/react.js"
    },
    "./types/solid": {
      "types": "./dist/types/solid.d.ts",
      "default": "./dist/types/solid.js"
    },
    "./types/preact": {
      "types": "./dist/types/preact.d.ts",
      "default": "./dist/types/preact.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "stencil build --dev --watch --serve",
    "build": "stencil build",
    "build:all": "bun run build && panda lib --files './**/*.{js,mjs}'",
    "postbuild": "bun tooling/scripts/finalize-types.ts && publint",
    "codegen": "panda codegen",
    "test": "bun tooling/scripts/stencil-test.ts && bun run test:framework-types",
    "test:unit": "bun tooling/scripts/stencil-test.ts --project unit",
    "test:integration": "bun tooling/scripts/stencil-test.ts --project integration",
    "test:browser": "bun tooling/scripts/stencil-test.ts --project browser",
    "test:smoke": "bun tooling/scripts/stencil-test.ts --project smoke",
    "test:watch": "bun tooling/scripts/stencil-test.ts --watch",
    "test:framework-types": "bun tooling/scripts/require-built-types.ts && tsc -p tests/fixtures/framework-types/react/tsconfig.json && tsc -p tests/fixtures/framework-types/solid/tsconfig.json && tsc -p tests/fixtures/framework-types/preact/tsconfig.json",
    "prepublishOnly": "bun run build:all"
  },
  "dependencies": {
    "@maskito/core": "^5.6.1",
    "@material/material-color-utilities": "^0.4.0",
    "@stencil/core": "^4.45.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.93.0",
    "@pandacss/compiler": "2.5.0",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/eslint-plugin": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@pandacss/transformer": "2.5.0",
    "@stencil/eslint-plugin": "^1.4.1",
    "@stencil/types-output-target": "^1.1.0",
    "@stencil/vitest": "^1.16.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^5.1.0",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.158.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "preact": "^11",
    "rollup": "^4.68.3",
    "solid-js": "^1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.5.0",
    "@types/react": ">=19",
    "preact": ">=10.28.0",
    "solid-js": ">=1"
  },
  "peerDependenciesMeta": {
    "@pandacss/dev": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

{
  "name": "@quanttrinh/solid-qui",
  "version": "0.0.1",
  "private": false,
  "description": "SolidJS Material Design 3 inspired component library, built on zag.js",
  "keywords": [
    "material-3",
    "material-design",
    "md3",
    "solid",
    "solid-qui",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanttrinh/solid-qui.git",
    "directory": "packages/solid-qui"
  },
  "files": [
    "dist",
    "styled-system",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/panda/styles.css",
    "./styles/*": "./dist/panda/styles/*",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./recipes": {
      "types": "./styled-system/recipes/index.d.ts",
      "default": "./styled-system/recipes/index.js"
    },
    "./recipes/*": {
      "types": "./styled-system/recipes/*.d.ts",
      "default": "./styled-system/recipes/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prepare": "$npm_execpath run codegen",
    "codegen": "panda codegen",
    "build": "panda codegen && vite build && panda lib --minify && panda cssgen --minify --splitting --outdir dist/panda",
    "lint": "oxlint --config oxlint.config.ts src",
    "lint:fix": "oxlint --config oxlint.config.ts --fix src",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@tanstack/solid-virtual": "^3.13.40",
    "@zag-js/accordion": "^1.46.0",
    "@zag-js/checkbox": "^1.46.0",
    "@zag-js/collection": "^1.46.0",
    "@zag-js/combobox": "^1.46.0",
    "@zag-js/dialog": "^1.46.0",
    "@zag-js/radio-group": "^1.46.0",
    "@zag-js/select": "^1.46.0",
    "@zag-js/solid": "^1.46.0",
    "@zag-js/switch": "^1.46.0",
    "@zag-js/tabs": "^1.46.0"
  },
  "devDependencies": {
    "@iconify-solid/material-symbols": "^1.0.31",
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "@pandacss/vite": "^2.2.0",
    "@types/node": "^26.6.5",
    "eslint-plugin-solid": "^0.17.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rollup-plugin-node-externals": "^9.0.1",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "@iconify-solid/material-symbols": "^1.0.31",
    "@pandacss/dev": "^2.2.0",
    "solid-js": "^1.9.15"
  }
}

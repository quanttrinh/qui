{
  "name": "@quanttrinh/solid-md3",
  "version": "1.1.0",
  "private": false,
  "description": "SolidJS Material Design 3 inspired component library",
  "keywords": [
    "components",
    "material-3",
    "material-design",
    "md3",
    "solid",
    "solid-js",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanttrinh/solid-md3.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "style": "./src/styles.css",
      "solid": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build",
    "lint": "oxlint --config oxlint.config.ts src",
    "lint:fix": "oxlint --config oxlint.config.ts --fix src",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check"
  },
  "devDependencies": {
    "@ark-ui/solid": "^5.38.2",
    "@iconify-solid/material-symbols": "^1.0.30",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-pacer": "^0.22.0",
    "@tanstack/solid-virtual": "^3.13.36",
    "@typescript/typescript6": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-plugin-solid": "^0.16.0",
    "fuse.js": "^7.5.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rollup-plugin-node-externals": "^9.0.1",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "@ark-ui/solid": "^5.38.2",
    "@iconify-solid/material-symbols": "^1.0.30",
    "@tanstack/solid-pacer": "^0.22.0",
    "@tanstack/solid-virtual": "^3.13.36",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependenciesMeta": {
    "@ark-ui/solid": {
      "optional": true
    },
    "@iconify-solid/material-symbols": {
      "optional": true
    },
    "@tanstack/solid-pacer": {
      "optional": true
    },
    "@tanstack/solid-virtual": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "fuse.js": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    }
  }
}

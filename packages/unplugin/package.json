{
  "name": "@quanttrinh/qui-unplugin",
  "version": "0.2.1",
  "description": "Bundler plugin for auto-registering @quanttrinh/qui components",
  "homepage": "https://quanttrinh.github.io/qui/",
  "bugs": {
    "url": "https://github.com/quanttrinh/qui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanttrinh/qui.git",
    "directory": "packages/unplugin"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "bun tooling/build.ts",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.157.0",
    "parse5": "^8.1.0",
    "pathe": "^2.0.3",
    "unplugin": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@quanttrinh/qui": ">=0.6.0 <0.7.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

{
    "name": "Bun",
    "build": {
        "dockerfile": "Containerfile",
        "context": ".."
    },
    "secrets": {
        "DOCKERHUB_USER": {},
        "DOCKERHUB_TOKEN": {}
    },
    "customizations": {
        "vscode": {
            "extensions": ["oven.bun-vscode", "bradlc.vscode-tailwindcss", "oxc.oxc-vscode"],
            "settings": {
                "editor.codeActionsOnSave": {
                    "source.fixAll.oxc": "always"
                },
                "editor.defaultFormatter": "oxc.oxc-vscode",
                "editor.formatOnSave": true
            }
        }
    },
    "initializeCommand": ["./.devcontainer/initialize.sh"],
    "postStartCommand": "bun install --frozen-lockfile"
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "description": "Workspace packages are resolved from the local monorepo, not the registry",
      "matchPackageNames": [
        "@quanttrinh/qui",
        "@quanttrinh/qui-server",
        "@quanttrinh/qui-unplugin"
      ],
      "enabled": false
    },
    {
      "description": "Framework packages follow the major version pinned by consumers",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "preact",
        "solid-js"
      ],
      "enabled": false
    },
    {
      "description": "Expose the update type as a label for the auto-approve workflow",
      "matchUpdateTypes": ["major"],
      "addLabels": ["update-type:major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["update-type:minor", "ai-review"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["update-type:patch", "ai-review"]
    },
    {
      "description": "Pins and digest-only updates are never auto-approved",
      "matchUpdateTypes": ["pin", "digest"],
      "addLabels": ["update-type:pin"]
    },
    {
      "description": "Bun tags are prefixed, which semver-coerced reports as unstable; allow stable X.Y.Z tags and skip canary builds",
      "matchDatasources": ["github-release-attachments"],
      "matchPackageNames": ["oven-sh/bun"],
      "ignoreUnstable": false,
      "allowedVersions": "/^bun-v\\d+\\.\\d+\\.\\d+$/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bun release tag + checksum, kept in one match so the digest is updated with the version",
      "managerFilePatterns": ["/^scripts\\/tools\\/bun\\.env$/"],
      "matchStrings": [
        "BUN_TAG=(?<currentValue>bun-v\\d+\\.\\d+\\.\\d+)\\s+BUN_SHA256=(?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "oven-sh/bun",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "OpenCode CLI version + npm SRI integrity, kept in one match so the digest is updated with the version",
      "managerFilePatterns": ["/^scripts\\/tools\\/opencode\\.env$/"],
      "matchStrings": [
        "OPENCODE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s+OPENCODE_INTEGRITY=(?<currentDigest>sha512-[A-Za-z0-9+/=]+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@opencode/cli-linux-x64",
      "versioningTemplate": "npm"
    }
  ]
}

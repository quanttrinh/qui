{
  "name": "@quanttrinh/qui",
  "version": "0.2.0",
  "description": "Material Design 3 web components built with Stencil",
  "homepage": "https://quanttrinh.github.io/qui/",
  "bugs": {
    "url": "https://github.com/quanttrinh/qui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanttrinh/qui.git"
  },
  "files": [
    "dist",
    "styled-system",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/shared/index.js",
  "module": "./dist/shared/index.js",
  "types": "./dist/types/index.d.ts",
  "imports": {
    "#styled-system/css": "./styled-system/css/index.js",
    "#qui-style-url": "./styled-system/style-urls/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./split": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/split/index.js"
    },
    "./register": {
      "types": "./dist/utilities/register.d.ts",
      "default": "./dist/utilities/register.js"
    },
    "./unplugin": {
      "types": "./dist/unplugin/index.d.ts",
      "default": "./dist/unplugin/index.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate/shared/index.d.ts",
      "import": "./dist/hydrate/shared/index.mjs",
      "require": "./dist/hydrate/shared/index.js"
    },
    "./hydrate/split": {
      "types": "./dist/hydrate/split/index.d.ts",
      "import": "./dist/hydrate/split/index.mjs",
      "require": "./dist/hydrate/split/index.js"
    },
    "./shared/*": "./dist/shared/*.js",
    "./split/*": "./dist/split/*.js",
    "./theme.css": "./styled-system/theme.css",
    "./styles.css": "./styled-system/styles.css",
    "./base.css": "./styled-system/base.css",
    "./split.css": "./styled-system/base.css",
    "./split/components/*.css": "./styled-system/split/components/*.css",
    "./package.json": "./package.json",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prepare": "bun -e \"try{require('husky')()}catch{}\"",
    "dev": "bun run build:utilities && stencil build --dev --watch --serve",
    "dev:split": "bun run build:utilities && STYLE_STRATEGY=split stencil build --dev --watch --serve",
    "build": "stencil build && bun run build:utilities && bun run build:unplugin",
    "build:split": "STYLE_STRATEGY=split stencil build && bun run build:utilities && bun run build:unplugin",
    "build:utilities": "bun build/build-utilities.ts",
    "build:unplugin": "bun build/build-unplugin.ts",
    "codegen": "panda codegen",
    "lint": "oxlint --config oxlint.config.ts src",
    "test": "stencil-test",
    "test:unit": "stencil-test --project unit",
    "test:browser": "stencil-test --project browser",
    "test:watch": "stencil-test --watch",
    "lint:fix": "oxlint --config oxlint.config.ts --fix src",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check",
    "version": "changeset version",
    "release": "changeset publish",
    "build:all": "stencil build && STYLE_STRATEGY=split stencil build && bun run build:utilities && bun run build:unplugin && bun run build:lib",
    "prepublishOnly": "bun run build:all",
    "build:lib": "panda lib --files './**/*.{js,mjs}'"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@stencil/core": "^4.45.2",
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.155.0",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/preset-panda": "^2.4.0",
    "@pandacss/rollup": "2.4.0",
    "@stencil/eslint-plugin": "^1.4.0",
    "@stencil/vitest": "^1.16.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^5.0.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "@pandacss/dev": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

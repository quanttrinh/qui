{
  "name": "@quanttrinh/qui-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun -e \"try{require('husky')()}catch{}\"",
    "dev": "bun run --cwd packages/qui dev",
    "build": "bun run --cwd packages/qui build && bun run --cwd packages/server build && bun run --cwd packages/unplugin build",
    "build:release": "bun run --cwd packages/qui build:release && bun run --cwd packages/server build && bun run --cwd packages/unplugin build",
    "build:lib": "bun run --cwd packages/qui build:lib",
    "test": "bun run --cwd packages/qui test && bun run --cwd packages/qui test:framework-types && bun run --cwd packages/server test && bun run --cwd packages/unplugin test",
    "test:unit": "bun run --cwd packages/qui test:unit && bun run --cwd packages/server test:unit && bun run --cwd packages/unplugin test:unit",
    "test:integration": "bun run --cwd packages/qui test:integration",
    "test:browser": "bun run --cwd packages/qui test:browser",
    "test:smoke": "bun run --cwd packages/qui test:smoke",
    "test:watch": "bun run --cwd packages/qui test:watch",
    "test:watch:unplugin": "bun run --cwd packages/unplugin test:watch",
    "test:watch:server": "bun run --cwd packages/server test:watch",
    "lint": "oxlint packages/qui/src packages/server/src packages/unplugin/src",
    "lint:fix": "oxlint --fix packages/qui/src packages/server/src packages/unplugin/src",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.8",
    "tsdown": "^0.23.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

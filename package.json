{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --bun run --filter ./packages/demo dev",
    "build-preview": "bun --bun run --filter ./packages/demo build",
    "publish": "cd packages/solid-md3 && bun --bun run build && bun publish",
    "lint": "bun --bun run --filter ./packages/solid-md3 lint",
    "lint:fix": "bun --bun run --filter ./packages/solid-md3 lint:fix",
    "fmt": "bun --bun run --filter ./packages/solid-md3 fmt",
    "fmt:check": "bun --bun run --filter ./packages/solid-md3 fmt:check",
    "version": "changeset version && python3 scripts/sync-lockfile-version.py"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}

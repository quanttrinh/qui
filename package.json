{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter ./packages/demo dev",
    "build-preview": "bun run --filter ./packages/demo build",
    "publish": "cd packages/solid-md3 && bun publish",
    "lint": "bun run --filter ./packages/solid-md3 lint",
    "lint:fix": "bun run --filter ./packages/solid-md3 lint:fix",
    "fmt": "bun run --filter ./packages/solid-md3 fmt",
    "fmt:check": "bun run --filter ./packages/solid-md3 fmt:check",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}

{
  "name": "@quanttrinh/qui-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun -e \"try{require('husky')()}catch{}\"",
    "dev": "bun run --cwd packages/qui dev",
    "build": "bun run --cwd packages/qui build && bun run --cwd packages/unplugin build",
    "build:release": "bun run --cwd packages/qui build:release && bun run --cwd packages/unplugin build",
    "build:lib": "bun run --cwd packages/qui build:lib",
    "test": "bun run --cwd packages/qui test && bun run --cwd packages/unplugin test",
    "test:unit": "bun run --cwd packages/qui test:unit && bun run --cwd packages/unplugin test:unit",
    "test:integration": "bun run --cwd packages/qui test:integration",
    "test:browser": "bun run --cwd packages/qui test:browser",
    "test:smoke": "bun run --cwd packages/qui test:smoke",
    "test:watch": "bun run --cwd packages/qui test:watch",
    "lint": "oxlint --config oxlint.config.ts packages/qui/src packages/unplugin/src",
    "lint:fix": "oxlint --config oxlint.config.ts --fix packages/qui/src packages/unplugin/src",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@stencil/eslint-plugin": "^1.4.0",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

{
  "name": "@quanttrinh/qui-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun -e \"try{require('husky')()}catch{}\"",
    "dev": "bun run --cwd packages/qui dev",
    "build": "bun run --workspaces --sequential build",
    "test": "bun run --workspaces --sequential test",
    "lint": "oxlint packages/qui/src packages/server/src packages/unplugin/src",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.8",
    "tsdown": "^0.23.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
